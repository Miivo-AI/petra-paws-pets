# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ziina Payment Gateway
# Docs: https://docs.ziina.com/getting-started
ZIINA_API_KEY=your-ziina-bearer-token
ZIINA_API_URL=https://api-v2.ziina.com/api
# Secret set when registering the webhook URL with Ziina (POST /webhook —
# see docs.ziina.com/api-reference/webhook). Verifies the X-Hmac-Signature
# header on incoming webhook calls to /api/webhooks/ziina.
ZIINA_WEBHOOK_SECRET=your-ziina-webhook-secret
# Set to "true" to create test payment_intents (docs.ziina.com/test-cards) —
# lets you pay with Ziina's test card numbers with no real charge. Purely
# server-side; there is no UI toggle. NEVER set this to "true" in your
# Production environment scope on Vercel — only Preview/Development, and
# unset it as soon as you're done testing.
ZIINA_TEST_MODE=false

# Bearer token required on GET /api/cron/reconcile-bookings. Point an
# external scheduler (Vercel Cron, cron-job.org) at that route every few
# minutes with `Authorization: Bearer <this value>` — it's the backstop
# that catches payments Ziina completed but that never made it back
# through the redirect or the webhook.
CRON_SECRET=your-cron-secret

# Resend (transactional email — https://resend.com)
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@petrapaws.com
# Must be on a domain verified in resend.com/domains (SPF/DKIM records
# added at your DNS host). Do NOT use the onboarding@resend.dev sandbox
# address here — Resend restricts it to only deliver to the email
# address the Resend account itself was registered with, so real
# customer confirmation emails would silently never arrive.
EMAIL_FROM=bookings@petrapawspets.com

# WhatsApp Cloud API (outbound booking-confirmation notifications —
# lib/whatsapp/client.ts).
# Docs: developers.facebook.com/docs/whatsapp/cloud-api
# Fallback credentials, only used when no connection has been made from
# /admin/whatsapp (see whatsapp_connection table, migration 007) — that
# page is the normal way to connect a number now, via Embedded Signup.
# Access token for the WhatsApp Business app (Meta App Dashboard → WhatsApp → API Setup).
WHATSAPP_TOKEN=your-whatsapp-access-token
# The Phone Number ID (not the phone number itself) shown on the same page.
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Graph API version — bump when Meta deprecates the current one.
WHATSAPP_API_VERSION=v21.0

# Meta Tech Provider app credentials for WhatsApp Embedded Signup, used by
# the /admin/whatsapp "Connect WhatsApp" page (components/admin/WhatsAppConnect.tsx).
# These belong to *our* Meta App (developers.facebook.com/apps), not to any
# individual client's number — the whole point of Embedded Signup is that a
# client can connect their own already-in-use WhatsApp Business number
# without us ever touching their Meta account by hand. Required when the
# Meta App is configured as a Tech Provider with WhatsApp Embedded Signup
# turned on (App Dashboard → WhatsApp → Configuration).
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# WhatsApp Embedded Signup configuration ID (App Dashboard → WhatsApp →
# Configuration → Embedded Signup) — not the App ID above.
NEXT_PUBLIC_META_CONFIG_ID=your-embedded-signup-config-id

# Webhook receiver (app/api/webhooks/whatsapp/route.ts) — required for
# "coexistence" (connecting a number already active in the WhatsApp
# Business mobile app): Meta won't show that option in the Embedded
# Signup popup at all until the app has a working webhook subscribed to
# the history / smb_app_state_sync / smb_message_echoes fields (App
# Dashboard → WhatsApp → Configuration → Webhooks). Not needed for the
# plain new-number signup flow.
# Callback URL to register there: <your public URL>/api/webhooks/whatsapp
# (must be publicly reachable over HTTPS — use ngrok for local testing,
# e.g. `ngrok http 3000`, then use the ngrok URL both here and as the
# page you open /admin/whatsapp on, since Meta's SDK also requires HTTPS).
# Verify token: any string you make up — enter the same value in both
# places (here, and in the Meta dashboard's Webhooks setup field).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-own-made-up-verify-token

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production value — must be the custom domain, not the vercel.app
# deployment URL, or booking-status/payment-redirect links (email +
# post-payment redirect) will point at vercel.app instead of the site
# customers actually know.
# NEXT_PUBLIC_SITE_URL="https://petrapawspets.com"

ADMIN_EMAIL=admin@petrapaws.com
