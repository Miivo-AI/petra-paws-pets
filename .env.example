# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used ONLY by `npm run db:migrate` — the app
# itself never touches it. Project Settings → Database → Connection
# string. Use the session-mode pooler (port 5432) or the direct
# connection; the transaction-mode pooler on 6543 can't run migrations
# reliably. Contains the database password, so keep it out of git.
# SUPABASE_DB_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Ziina Payment Gateway
# Docs: https://docs.ziina.com/getting-started
ZIINA_API_KEY=your-ziina-bearer-token
ZIINA_API_URL=https://api-v2.ziina.com/api
# Secret set when registering the webhook URL with Ziina (POST /webhook —
# see docs.ziina.com/api-reference/webhook). Verifies the X-Hmac-Signature
# header on incoming webhook calls to /api/webhooks/ziina.
ZIINA_WEBHOOK_SECRET=your-ziina-webhook-secret
# Bearer token required on GET /api/cron/reconcile-bookings. Point an
# external scheduler (Vercel Cron, cron-job.org) at that route every few
# minutes with `Authorization: Bearer <this value>` — it's the backstop
# that catches payments Ziina completed but that never made it back
# through the redirect or the webhook.
CRON_SECRET=your-cron-secret

# Google Maps Distance Matrix API (for travel-time engine)
# Enable "Distance Matrix API" in Google Cloud Console
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Resend (transactional email — https://resend.com)
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@petrapaws.com
# Must be on a domain verified in resend.com/domains (SPF/DKIM records
# added at your DNS host). Do NOT use the onboarding@resend.dev sandbox
# address here — Resend restricts it to only deliver to the email
# address the Resend account itself was registered with, so real
# customer confirmation emails would silently never arrive.
EMAIL_FROM=Petra Paws <bookings@petrapawspets.com>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production value — must be the custom domain, not the vercel.app
# deployment URL, or booking-status/payment-redirect links (email +
# post-payment redirect) will point at vercel.app instead of the site
# customers actually know.
# NEXT_PUBLIC_SITE_URL="https://petrapawspets.com"

ADMIN_EMAIL=admin@petrapaws.com
# Set to "true" to create test payment_intents (docs.ziina.com/test-cards) —
# lets you pay with Ziina's test card numbers with no real charge. Purely
# server-side; there is no UI toggle. NEVER set this to "true" in your
# Production environment scope on Vercel — only Preview/Development, and
# unset it as soon as you're done testing.
ZIINA_TEST_MODE=false

# WhatsApp Cloud API — booking confirmations (lib/whatsapp/client.ts).
# See docs/WHATSAPP-NOTIFICATIONS-CLIENT-SETUP.md
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=booking_confirmed
WHATSAPP_TEMPLATE_LANGUAGE=en
# Must match the approved template exactly or every send fails with Meta
# error 132000. Valid names: customer_name, pet_name, booking_reference,
# date, time, service, zone, total. Set to an empty string if the approved
# template takes no parameters.
WHATSAPP_TEMPLATE_VARIABLES=customer_name,booking_reference,date,time,service,pet_name

# Path A — Coexistence. The owner keeps the number in the WhatsApp
# Business app; credentials are issued at runtime by Embedded Signup and
# stored in whatsapp_connection, so there is no token to set here.
# App ID and Embedded Signup configuration ID (App Dashboard → Facebook
# Login for Business → Configurations). Both are public.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-embedded-signup-config-id
# App Dashboard → App settings → Basic → App secret (Show). Used server-side
# to exchange the signup code for a token AND to verify X-Hub-Signature-256
# on every webhook delivery. Never expose it — /api/webhooks/whatsapp
# refuses all deliveries when it's unset rather than accepting unauthenticated
# ones.
META_APP_SECRET=your-meta-app-secret
# Any random string (e.g. `openssl rand -hex 32`). Must match the "Verify
# token" entered in App Dashboard → WhatsApp → Configuration → Webhooks.
# Subscribe to: messages, account_update, history, smb_app_state_sync,
# smb_message_echoes — coexistence onboarding will not appear in Embedded
# Signup until those are subscribed and returning 200.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# Path B — API-only fallback, unused while coexistence is the chosen path.
# Deliberately left unset: resolveConfig() only checks that WHATSAPP_TOKEN
# is non-empty, so a placeholder value here makes every send attempt a real
# API call and fail with Meta error 190 instead of skipping cleanly.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
