# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used ONLY by `npm run db:migrate` — the app
# itself never touches it. Project Settings → Database → Connection
# string. Use the session-mode pooler (port 5432) or the direct
# connection; the transaction-mode pooler on 6543 can't run migrations
# reliably. Contains the database password, so keep it out of git.
# SUPABASE_DB_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Ziina Payment Gateway
# Docs: https://docs.ziina.com/getting-started
ZIINA_API_KEY=your-ziina-bearer-token
ZIINA_API_URL=https://api-v2.ziina.com/api
# Secret set when registering the webhook URL with Ziina (POST /webhook —
# see docs.ziina.com/api-reference/webhook). Verifies the X-Hmac-Signature
# header on incoming webhook calls to /api/webhooks/ziina.
ZIINA_WEBHOOK_SECRET=your-ziina-webhook-secret
# Set to "true" to create test payment_intents (docs.ziina.com/test-cards) —
# lets you pay with Ziina's test card numbers with no real charge. Purely
# server-side; there is no UI toggle. NEVER set this to "true" in your
# Production environment scope on Vercel — only Preview/Development, and
# unset it as soon as you're done testing.
ZIINA_TEST_MODE=false

# Bearer token required on GET /api/cron/reconcile-bookings. Point an
# external scheduler (Vercel Cron, cron-job.org) at that route every few
# minutes with `Authorization: Bearer <this value>` — it's the backstop
# that catches payments Ziina completed but that never made it back
# through the redirect or the webhook.
CRON_SECRET=your-cron-secret

# Resend (transactional email — https://resend.com)
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@petrapaws.com
# Must be on a domain verified in resend.com/domains (SPF/DKIM records
# added at your DNS host). Do NOT use the onboarding@resend.dev sandbox
# address here — Resend restricts it to only deliver to the email
# address the Resend account itself was registered with, so real
# customer confirmation emails would silently never arrive.
EMAIL_FROM=bookings@petrapawspets.com

# ── WhatsApp Cloud API — booking confirmations ───────────────────────
# Docs: developers.facebook.com/docs/whatsapp/cloud-api
#        docs/WHATSAPP-NOTIFICATIONS-CLIENT-SETUP.md
WHATSAPP_API_VERSION=v21.0

# Approved template name + language, exactly as they appear in WhatsApp
# Manager → Message templates. A template approved as "en_US" will NOT
# match WHATSAPP_TEMPLATE_LANGUAGE=en — that mismatch is Meta error
# 132001 and it fails every single send.
WHATSAPP_TEMPLATE_NAME=booking_confirmed
WHATSAPP_TEMPLATE_LANGUAGE=en

# Which booking fields fill the template's {{1}}, {{2}}, … placeholders,
# in order. Must match the approved template exactly or every send fails
# with Meta error 132000. Valid names: customer_name, pet_name,
# booking_reference, date, time, service, zone, total. Set to an empty
# string if the approved template takes no parameters. Leave unset to use
# the default order below (which matches
# BOOKING_CONFIRMED_TEMPLATE_BODY in lib/whatsapp/messages.ts).
WHATSAPP_TEMPLATE_VARIABLES=customer_name,booking_reference,date,time,service,pet_name

# ── Credentials: pick ONE of the two paths below ─────────────────────
#
# Path A — Coexistence (the number stays live in the WhatsApp Business
# app on the owner's phone while this site sends confirmations from it).
# Credentials CANNOT come from env here: Meta only issues them at runtime
# when an admin completes Embedded Signup at /admin/whatsapp, and they're
# stored in the whatsapp_connection table. Requires the Meta app to be a
# Tech Provider with App Review-granted advanced access, plus all four
# vars below.
#
# App ID and the Embedded Signup configuration ID (App Dashboard →
# Facebook Login for Business → Configurations). Both are public.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-embedded-signup-config-id
# Used server-side to exchange the signup code for a token AND to verify
# the X-Hub-Signature-256 on every webhook delivery. Never expose it —
# /api/webhooks/whatsapp refuses all deliveries when it's unset rather
# than accepting unauthenticated ones.
META_APP_SECRET=your-meta-app-secret
# Any random string. Must match the "Verify token" entered in App
# Dashboard → WhatsApp → Configuration → Webhooks. Subscribe the webhook
# to: messages, account_update, history, smb_app_state_sync,
# smb_message_echoes — coexistence onboarding will not appear in
# Embedded Signup until those are subscribed and returning 200.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
#
# Path B — API-only number (no WhatsApp Business app on the same number).
# Used as the fallback whenever no connection row exists.
WHATSAPP_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production value — must be the custom domain, not the vercel.app
# deployment URL, or booking-status/payment-redirect links (email +
# post-payment redirect) will point at vercel.app instead of the site
# customers actually know.
# NEXT_PUBLIC_SITE_URL="https://petrapawspets.com"

ADMIN_EMAIL=admin@petrapaws.com
